# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Entorno (nunca subir claves)
.env
.env.*
!.env.example

# Datos fuente y derivados: contienen datos personales y credenciales
*.xlsx
*.xls
*.csv
!.claude/skills/**/*.csv
# Mapeos de la migración: sin datos personales, se revisan y versionan
!scripts/migracion/mapeos/*.csv
scripts/migracion/salida/
docs/**/*.pdf

# Supabase local
supabase/.branches
supabase/.temp

# Python
__pycache__/
*.pyc

# Netlify (estado local del enlace)
.netlify

# Playwright: sesiones de prueba (contienen tokens), reportes y resultados
e2e/.sesiones/
e2e/reporte/
e2e/resultados/

# Reportes locales de las skills de diseño (Impeccable)
.impeccable/
